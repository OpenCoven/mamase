# Copy to .env.local for local development. Never commit real credentials.
# Use a WorkOS staging environment locally and its production environment on Vercel.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate a stable secret with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://127.0.0.1:4173/api/auth/callback
# Approved accounts, comma- or newline-separated. Full addresses
# (member@coven.example) and whole domains (@coven.example) are both accepted.
# Leaving this empty approves nobody: every signed-in visitor stays on the
# approval gate until their address is listed.
MAMASE_ACCESS_LIST=
